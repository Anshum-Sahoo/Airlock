# ==============================================================================
# Airlock MVP Environment Configuration (contracts v1.2.0)
# Copy this file to .env and fill in real values locally. NEVER commit .env.
#
# TRUST BOUNDARIES - give each process ONLY its own section:
#   [BACKEND]   the FastAPI gateway; the only process that may see the databases
#               and the reviewer token.
#   [DASHBOARD] the Next.js app; public values only. NEVER put a token or API key
#               in a NEXT_PUBLIC_* variable.
#   [AGENT]     the Python agent runner; agent token and NVIDIA key only. It must
#               NOT receive any database path or the reviewer token (start it with
#               its own env file, e.g. .env.agent, containing only this section).
# ==============================================================================

# ------------------------------- [BACKEND] ------------------------------------
# Local-only demo: bind to loopback. Do not bind to 0.0.0.0.
AIRLOCK_HOST=127.0.0.1
AIRLOCK_PORT=8000

# Enables POST /api/demo/reset. The backend refuses to start with true when
# AIRLOCK_HOST is not a loopback address.
AIRLOCK_DEMO_MODE=true

AIRLOCK_PROD_DB_PATH=./data/airlock_prod.db
# Session metadata and manifests (separate from every speculative invoice DB)
AIRLOCK_META_DB_PATH=./data/airlock_meta.db
AIRLOCK_SPECULATIVE_DIR=./data/speculative_dbs
AIRLOCK_CONTRACTS_DIR=./contracts

# Agent bearer token. Required on agent-only endpoints:
#   POST /api/sessions
#   POST /api/tools/execute
#   POST /api/sessions/{session_id}/complete
# It never authorizes commit, rollback or reset.
AIRLOCK_AGENT_TOKEN=change-me-agent-token-generate-a-random-value

# Reviewer bearer token. Required on reviewer-only endpoints (human approval):
#   POST /api/sessions/{session_id}/commit
#   POST /api/sessions/{session_id}/rollback
#   POST /api/demo/reset (also needs AIRLOCK_DEMO_MODE=true and a loopback client)
# Must differ from AIRLOCK_AGENT_TOKEN (startup fails if empty or identical).
# The human reviewer types it into the dashboard; it is never bundled.
AIRLOCK_REVIEWER_TOKEN=change-me-reviewer-token-generate-a-different-value

# Comma-separated allowed CORS origins for the Next.js dashboard.
# CORS is NOT authentication; it only controls which web origins may read responses.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------- [DASHBOARD] ----------------------------------
# Public URL of the gateway (safe for browser exposure; no secrets here)
NEXT_PUBLIC_AIRLOCK_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_POLL_INTERVAL_MS=2000

# --------------------------------- [AGENT] ------------------------------------
AIRLOCK_API_BASE_URL=http://127.0.0.1:8000
# The agent runner also needs the SAME value as AIRLOCK_AGENT_TOKEN above
# (copy it into the agent's own env file). Never give it the reviewer token.

# NVIDIA Nemotron API credentials (STRICTLY agent-side; NEVER expose to Next.js)
NVIDIA_API_KEY=nvapi-replace-with-your-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
