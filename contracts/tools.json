    {
      "name": "update_invoice",
      "description": "Update one or more agent-mutable fields (status, amount_cents, due_date, notes) of an existing invoice in the speculative database. At least one must be provided. Increments version and sets updated_at. A call whose values all equal the current values succeeds with mutations_recorded 0. A notes value containing a secret marker is rejected (422 INVALID_ARGUMENTS, reason SECRET_IN_ARGUMENT) because mutation records are replayed verbatim at commit and must never be redacted.",
      "read_only": false,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_id"
        ],
        "anyOf": [
          {
            "required": [
              "status"
            ]
          },
          {
            "required": [
              "amount_cents"
            ]
          },
          {
            "required": [
              "due_date"
            ]
          },
          {
            "required": [
              "notes"
            ]
          }
        ],
        "properties": {
          "invoice_id": {
            "type": "string",
            "pattern": "^INV-\\d{4}$",
            "description": "Target invoice ID."
          },
          "status": {
            "type": "string",
            "enum": [
              "OVERDUE",
              "PAID",
              "PENDING",
              "CANCELLED"
            ],
            "description": "New invoice status."
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "description": "Updated invoice amount in cents."
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Updated due date (YYYY-MM-DD)."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "description": "Updated billing notes."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "updated_invoice"
        ],
        "properties": {
          "updated_invoice": {
            "$ref": "invoice.schema.json"
          }
        }
      },
      "errors": [
        "INVALID_ARGUMENTS",
        "INVOICE_NOT_FOUND",
        "POLICY_BLOCK"
      ],
      "example_invocation": {
        "session_id": "b7d4e2c9-1a3f-4b68-8e52-6f9c0d7a3b21",
        "tool_name": "update_invoice",
        "arguments": {
          "invoice_id": "INV-0042",
          "status": "PAID",
          "notes": "Wire transfer confirmed"
        }
      },
      "example_success_response": {
        "operation_id": "6e0a4c8f-1d7b-4e92-b3a5-f2c9d1e7b406",
        "session_id": "b7d4e2c9-1a3f-4b68-8e52-6f9c0d7a3b21",
        "tool_name": "update_invoice",
        "status": "SUCCESS",
        "read_only": false,
        "tool_decision": "ALLOW",
