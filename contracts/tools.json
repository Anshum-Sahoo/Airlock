    {
      "name": "bulk_delete_invoices",
      "description": "Delete multiple invoices in the speculative database. At least one of invoice_ids or status is required. AND semantics: when both are supplied only invoices whose id is in invoice_ids AND whose status equals status are deleted. Every ID in invoice_ids MUST exist in the speculative database; if any requested ID does not exist the ENTIRE call fails with 404 INVOICE_NOT_FOUND and nothing is deleted. Existing IDs that do not match the status filter are skipped and listed in unmatched_invoice_ids. A status-only call matching zero rows succeeds with 0 mutations. The whole call runs in one speculative-DB transaction.",
      "read_only": false,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "anyOf": [
          {
            "required": [
              "invoice_ids"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ],
        "properties": {
          "invoice_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^INV-\\d{4}$"
            },
            "description": "Explicit invoice IDs. All must exist."
          },
          "status": {
            "type": "string",
            "enum": [
              "OVERDUE",
              "PAID",
              "PENDING",
              "CANCELLED"
            ],
            "description": "Status filter (AND-ed with invoice_ids when both are supplied)."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Optional audit reason (stored redacted)."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted_count",
          "deleted_invoice_ids",
          "unmatched_invoice_ids"
        ],
        "properties": {
          "deleted_count": {
            "type": "integer",
            "minimum": 0
          },
          "deleted_invoice_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^INV-\\d{4}$"
            }
          },
          "unmatched_invoice_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^INV-\\d{4}$"
            },
            "description": "Requested IDs that exist but do not match the status filter. Empty when status is not supplied."
          }
        }
      },
      "errors": [
        "INVALID_ARGUMENTS",
        "INVOICE_NOT_FOUND",
        "POLICY_BLOCK"
      ],
      "example_invocation": {
        "session_id": "3f2b8a1e-5c4d-4e7a-9b1f-0a6d2c8e4f10",
        "tool_name": "bulk_delete_invoices",
        "arguments": {
          "status": "OVERDUE",
          "reason": "Purge all overdue invoices"
        }
      },
