  "tools": [
    {
      "name": "list_invoices",
      "description": "List invoices from the session's speculative SQLite database with optional status and customer-name filters (AND-ed) and pagination. Ordered by id ascending.",
      "read_only": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OVERDUE",
              "PAID",
              "PENDING",
              "CANCELLED"
            ],
            "description": "Optional invoice status filter."
          },
          "customer_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Case-insensitive substring filter on customer_name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50,
            "description": "Maximum number of invoices to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Pagination offset."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total_matching",
          "returned",
          "invoices"
        ],
        "properties": {
          "total_matching": {
            "type": "integer",
            "minimum": 0
          },
          "returned": {
            "type": "integer",
            "minimum": 0
          },
          "invoices": {
            "type": "array",
            "items": {
              "$ref": "invoice.schema.json"
            }
          }
        }
      },
      "errors": [
        "INVALID_ARGUMENTS"
      ],
      "example_invocation": {
        "session_id": "b7d4e2c9-1a3f-4b68-8e52-6f9c0d7a3b21",
