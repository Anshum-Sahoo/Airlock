    {
      "name": "stage_webhook",
      "description": "Stage an outbound webhook notification in the session manifest. Webhooks are staged only and are NEVER dispatched. Records zero invoice mutations (mutations_recorded is always 0). url, event_type and payload are scanned by POL-003 (secret markers) and POL-004 (destination allowlist) before staging; a violation returns 403 POLICY_BLOCK and sets the session gate to BLOCK.",
      "read_only": false,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "event_type",
          "payload"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "HTTPS destination URL; hostname must exactly match allowed_webhook_domains."
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Event identifier (e.g., invoice.updated)."
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON payload (serialized size at most 64 KiB)."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "webhook_id",
          "url",
          "event_type",
          "staged_status"
        ],
        "properties": {
          "webhook_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "event_type": {
            "type": "string"
          },
          "staged_status": {
            "const": "STAGED"
          }
        }
      },
      "errors": [
        "INVALID_ARGUMENTS",
        "POLICY_BLOCK"
      ],
      "example_invocation": {
        "session_id": "b7d4e2c9-1a3f-4b68-8e52-6f9c0d7a3b21",
