# Airlock Frontend — local environment example
#
# Copy to .env.local and edit for local development.
# .env.local is gitignored and must never be committed.
#
# SECURITY: The reviewer token is NEVER an env variable.
# It is entered at runtime in the UI password field and kept in page memory only.
# It is never in NEXT_PUBLIC_*, localStorage, sessionStorage, cookies, or URLs.

# Backend base URL (public, non-secret)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" to use mock data for UI preview (no backend required)
# Remove or set to "false" for production
NEXT_PUBLIC_MOCK_MODE=true
